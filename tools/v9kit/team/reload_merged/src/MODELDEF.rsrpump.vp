// RSR-PUMP (zscript/rsr/rsr_pump.zs, tools/gen_pump.py): V+/VR_Shotgun. The gun's own model and
// frames; pieces shown or hidden by a clear skin (every surface has its own SurfaceSkin:
// models_md3.cpp reads SurfaceSkin only when a block has no Skin).

// the gun without its pump (they are on their own layers while the hand works it)
Model VR_Shotgun
{
	Path "Models/Weapons/Hud/guns"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "WPN-GUNS.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-GUNS.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQUH A 0 0
}

// the pump alone (main controller)
Model RSR_GunParts
{
	Path "Models/Weapons/Hud/guns"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "WPN-GUNS.png"
	SurfaceSkin 0 2 "rsr_clear.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQUQ A 0 0
}

// the shell alone, at the loading port (D-I: the set's own ejected shell, Fire M-R)
Model RSR_GunParts
{
	Path "Models/Weapons/Hud/guns"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-GUNS.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQUQ C 0 12
	FrameIndex RQUQ D 0 12
	FrameIndex RQUQ E 0 13
	FrameIndex RQUQ F 0 14
	FrameIndex RQUQ G 0 15
	FrameIndex RQUQ H 0 16
	FrameIndex RQUQ I 0 17
}

// the shell alone, in the off hand (off controller)
Model RSQ_Hands
{
	Path "Models/Weapons/Hud/guns"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-GUNS.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQUQ C 0 12
}

// a dropped shell (world)
Model RSP_DroppedShell
{
	Path "Models/Weapons/Hud/guns"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-GUNS.png"
	Scale 0.4682 -0.4682 0.4682
	Offset -14.9549 0.1674 0.0
	ZOffset 0.7292
	USEACTORPITCH
	USEACTORROLL
	FrameIndex RQUX A 0 12
}
