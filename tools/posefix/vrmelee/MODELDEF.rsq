// RS VR hands (zscript/rsq/hands.zs). Hands and poses: Ermac, Force Unleashed /
// Rusted Legacy (MIT, models/rsq/LICENSE_RustedLegacy_MIT.txt), drawn the way his
// weapons draw them; generated by rsq_hands_gen.py from hands/fits.json.

// the gun hand (main controller) and the support hand (main controller, on the gun)
Model RSQ_GunSide
{
	Path "models/rsq"
	Model 0 "hand.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQGS A 0 2	// Ermac hand.md3 frame 6
	FrameIndex RQGS B 0 3	// Ermac hand.md3 frame 19
	FrameIndex RQGS C 0 4	// Ermac hand.md3 frame 30
	FrameIndex RQGS D 0 5	// Ermac hand.md3 frame 47
	FrameIndex RQGS E 0 6	// Ermac hand.md3 frame 95
	FrameIndex RQGS F 0 7	// Ermac hand.md3 frame 106
	FrameIndex RQGS G 0 8	// Ermac hand.md3 frame 113
}

Model RSQ_GunSide
{
	Path "models/rsq"
	Model 0 "hand2.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQSP A 0 0	// Ermac hand2.md3 frame 4
	FrameIndex RQSP B 0 1	// Ermac hand2.md3 frame 15
	FrameIndex RQSP C 0 2	// Ermac hand2.md3 frame 33
	FrameIndex RQSP D 0 3	// Ermac hand2.md3 frame 80
	FrameIndex RQSP E 0 4	// Ermac hand2.md3 frame 91
}

