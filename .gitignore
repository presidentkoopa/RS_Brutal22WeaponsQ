# The packs and the base mods ARE tracked now (packs/, base/, through LFS). The old rule
# here excluded *.pk3 and *.zip, which is why they were missing from this repo for so long.
# Keep ignoring only genuine scratch.

__pycache__/
*.pyc
*.pyo

# render sheets and fitting output: working material, regenerated by the tools
_renders/
_scratch/
tools/**/out/
tools/**/__out/

# a local engine build, test logs and configs
*.log
*.ini

# the Linux headless QuestZDoom build: 27 MB, useless on Windows, and not ours
qzd_headless.zip

# editor and OS litter
.vscode/
.idea/
Thumbs.db
desktop.ini
v9kit.zip
trigger_finger_kit.zip
