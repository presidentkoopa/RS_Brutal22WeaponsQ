ACTOR MG42 : BrutalWeapon
{
	Game Doom
	Weapon.SelectionOrder 1
	Weapon.AmmoUse 1
	Weapon.AmmoType "Clip2"
	+WEAPON.ALT_USES_BOTH
	-WEAPON.AMMO_CHECKBOTH
	-INVENTORY.UNDROPPABLE
	Inventory.PickupMessage "$GOTMG42"
	Obituary "$OBBD_MG42"
	Tag "$TAGBD_MG42"
	States
	{
	KickFlash:
		PBUS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		HBUS GHIJ 1
		HBUS K 10
		HBUS JIHG 1
		stop
	SlideFlash:
		PBUS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		HBUS GHIJ 1
		HBUS K 35
		stop
	SlideFlashEnd:
		PBUS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		HBUS K 5
		HBUS JIHG 1
		stop
	SlideFlashEndEarly:
		PBUS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		HBUS K 2
		HBUS JIHG 1
		stop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 18) )
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_GiveInventory("MG42Selected",1)
		TNT1 A 0 A_PlaySound("MG42/Draw", 5)
		PBUS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
	SelectAnimation:
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		HBUS ONML 1 A_WeaponReady(WRF_NOFIRE)
	Ready:
	Ready3:
		PBUS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		HBUS A 0 	
		"####" A 1 A_WeaponReady
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		Loop

	Deselect:
		HBUS A 0 A_TakeInventory("TossGrenade", 1)
		PBUS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		HBUS PQRS 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 0 A_Lower
		Wait

	Fire:
		PBUS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		HBUS A 0 	
		"####" A 0
		"####" A 0 A_JumpIfNoAmmo("Ready3")
		"####" A 0 A_ZoomFactor(0.98)		
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",30,5,27)		
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 0 BRIGHT A_FireBullets (2, 2, 1, 24, "ExtremeBulletPuff", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_FireCustomMissile("ShakeYourAss", 0, 0, 0, 0)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_AlertMonsters
		"####" A 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		"####" A 0 A_FireCustomMissile("YellowFlareSpawn",-5,0,0,0)
		"####" A 0 A_FireCustomMissile("50CaseSpawn2",5,0,6,-6)
		"####" A 0 A_SetPitch(-0.2 + pitch)
		"####" B 1 BRIGHT A_ZoomFactor(1.0)
		"####" A 0 A_SetPitch(0.2 + pitch)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0
		"####" A 0 A_SetAngle(random(1, -1) + angle)
		"####" A 0 A_ZoomFactor(0.98)		
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,27)
		"####" A 0 BRIGHT A_FireBullets (2, 2, 1, 24, "ExtremeBulletPuff", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		"####" A 0 A_FireCustomMissile("YellowFlareSpawn",-5,0,0,0)
		"####" A 0 A_FireCustomMissile("50CaseSpawn2",5,0,6,-6)
		"####" A 0 A_SetPitch(-0.2 + pitch)
		"####" C 1 BRIGHT A_ZoomFactor(1.0)
		"####" A 0 A_SetPitch(0.2 + pitch)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0
		"####" A 0 A_SetAngle(random(1, -1) + angle)
		"####" F 1 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" A 0 A_Refire
		Goto Ready	
	
	DM: //Not ideal, but no real clean way to do this outside of state copypasta.
		"####" A 0 BRIGHT A_FireBullets (2, 2, 1, 24, "ExtremeBulletPuffDM", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_FireCustomMissile("ShakeYourAss", 0, 0, 0, 0)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_AlertMonsters
		"####" A 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		"####" A 0 A_FireCustomMissile("YellowFlareSpawn",-5,0,0,0)
		"####" A 0 A_FireCustomMissile("50CaseSpawn2",5,0,6,-6)
		"####" A 0 A_SetPitch(-0.2 + pitch)
		"####" B 1 BRIGHT A_ZoomFactor(1.0)
		"####" A 0 A_SetPitch(0.2 + pitch)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0
		"####" A 0 A_SetAngle(random(1, -1) + angle)
		"####" A 0 A_ZoomFactor(0.98)		
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,27)
		"####" A 0 BRIGHT A_FireBullets (2, 2, 1, 24, "ExtremeBulletPuffDM", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		"####" A 0 A_FireCustomMissile("YellowFlareSpawn",-5,0,0,0)
		"####" A 0 A_FireCustomMissile("50CaseSpawn2",5,0,6,-6)
		"####" A 0 A_SetPitch(-0.2 + pitch)
		"####" C 1 BRIGHT A_ZoomFactor(1.0)
		"####" A 0 A_SetPitch(0.2 + pitch)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0
		"####" A 0 A_SetAngle(random(1, -1) + angle)
		"####" F 1 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" A 0 A_Refire
		Goto Ready

	Spawn:
		HBUS D -1
		Stop

	StartSprint:
		HBUS A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")	
		HBUS GHI 1 A_WeaponReady(WRF_NOFIRE)
		HBUS A 0 A_Takeinventory("Zoomed",1)
		HBUS A 0 A_Takeinventory("ADSmode",1)
		HBUS A 0 A_ZoomFactor(1.0)
	Sprinting:
		HBUS A 0 offset(-9,32)
		//HBUS A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		HBUS A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		HBUS A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		HBUS A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		HBUS A 0 offset(-9,32) A_GiveInventory("UsedStamina", 9)
		HBUS A 0 offset(-9,32)
		HBUS J 1  offset(-9,34) A_SetPitch(pitch -0.5)
		HBUS J 1  offset(-6,36) A_SetPitch(pitch -0.5)
		HBUS J 1  offset(-3,38) A_SetPitch(pitch -0.5)
		HBUS J 1  offset(0,38) A_SetPitch(pitch -0.5)
		HBUS J 1  offset(3,36) A_SetPitch(pitch -0.5)
		HBUS J 1  offset(6,34) A_SetPitch(pitch -0.5)
		HBUS J 1  offset(9,32) A_SetPitch(pitch -0.5)
		HBUS A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		HBUS A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		HBUS A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		HBUS A 0 offset(-9,32) A_GiveInventory("UsedStamina", 9)
		HBUS A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		HBUS J 1  offset(9,34) A_SetPitch(pitch +0.5)
		HBUS J 1  offset(6,36) A_SetPitch(pitch +0.5)
		HBUS J 1  offset(3,38) A_SetPitch(pitch +0.5)
		HBUS J 1  offset(0,38) A_SetPitch(pitch +0.5)
		HBUS J 1  offset(-3,36) A_SetPitch(pitch +0.5)
		HBUS J 1  offset(-6,34) A_SetPitch(pitch +0.5)
		HBUS J 1  offset(-9,32) A_SetPitch(pitch +0.5)
		HBUS A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		HBUS A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		HBUS IHG 1
		HBUS A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		HBUS A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready
	}
}

ACTOR PuristMG42 : MG42 { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }