// RS VR grenade (2026-10-16): BD22's grenade, 0.92 size, set in Ermac's hand (RQGN above):
// ready (C), pin out (A, ring hidden) / spoon gone too (B)
Model HandGrenades
{
   Path "models/bd/Grenade"
   Model 0 "nade.md3"
   Skin 0 "nade.png"
   Scale -0.92 0.92 0.92
   Offset -4.01 -2.04 -1.45
   NoInterpolation
   ZOffset -5
   FrameIndex RQNP C 0 2
}
Model HandGrenades
{
   Path "models/bd/Grenade"
   Model 0 "nade.md3"
   SurfaceSkin 0 0 "nade.png"
   SurfaceSkin 0 1 "nade.png"
   SurfaceSkin 0 2 "rsr_clear.png"
   SurfaceSkin 0 3 "nade.png"
   SurfaceSkin 0 4 "nade.png"
   Scale -0.92 0.92 0.92
   Offset -4.01 -2.04 -1.45
   NoInterpolation
   ZOffset -5
   FrameIndex RQNP A 0 2
}
Model HandGrenades
{
   Path "models/bd/Grenade"
   Model 0 "nade.md3"
   SurfaceSkin 0 0 "nade.png"
   SurfaceSkin 0 1 "nade.png"
   SurfaceSkin 0 2 "rsr_clear.png"
   SurfaceSkin 0 3 "rsr_clear.png"
   SurfaceSkin 0 4 "rsr_clear.png"
   Scale -0.92 0.92 0.92
   Offset -4.01 -2.04 -1.45
   NoInterpolation
   ZOffset -5
   FrameIndex RQNP B 0 2
}

