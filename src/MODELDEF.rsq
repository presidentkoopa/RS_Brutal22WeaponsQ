// RS VR grenade (2026-10-16): BD22's grenade, 0.92 size, set in Ermac's hand (RQGN above):
// ready (C), pin out (A, ring hidden) / spoon gone too (B)
Model HandGrenades
{
   Path "models/bd/Grenade"
   Model 0 "nade.md3"
   Skin 0 "nade.png"
   Scale -0.92 0.92 0.92
   Offset -12.075 -8.898 0.0
   NoInterpolation
   ZOffset 2.326
   AngleOffset -18.317
   PitchOffset -17.735
   RollOffset 3.457	// grenade hand (lane B): gun to the FBX hand, fit_nade.py
   FrameIndex RQNP C 0 2
}
