// generated by rsq_hands_gen.py from hands/fits.json -- do not edit by hand
// Per gun: gun-hand frame (one hand, two hands), its hook and rotation, support frame, its hook
// and rotation (ModifyBobLayer3D units), and where the support hand holds the gun
// (metres in the gun hand's frame: forward, left, up).

class RSQ_HandTable abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		if (w is 'VR_Revolver')	return 1;
		if (w is 'VR_Revolver2')	return 2;
		if (w is 'VR_Rifle')	return 3;
		if (w is 'VR_Shotgun')	return 4;
		if (w is 'VR_SuperShotgun')	return 5;
		if (w is 'Vanilla_BFG9000')	return 6;
		if (w is 'Vanilla_Chaingun')	return 7;
		if (w is 'Vanilla_Chainsaw')	return 8;
		if (w is 'Vanilla_PlasmaRifle')	return 9;
		if (w is 'Vanilla_RocketLauncher')	return 10;
		return 0;
	}

	clearscope static String GunOne(int i)
	{
		static const String v[] = { "", "A", "A", "G", "D", "E", "H", "G", "C", "G", "F" };
		return i > 0 && i < v.Size() ? v[i] : "";
	}

	clearscope static String GunTwo(int i)
	{
		static const String v[] = { "", "B", "B", "G", "D", "E", "H", "G", "C", "G", "F" };
		return i > 0 && i < v.Size() ? v[i] : "";
	}

	clearscope static String Support(int i)
	{
		static const String v[] = { "", "A", "A", "B", "B", "C", "D", "E", "E", "B", "D" };
		return i > 0 && i < v.Size() ? v[i] : "";
	}

	clearscope static Vector3 GunHook(int i)
	{
		static const double x[] = { 0, 0.030, 0.030, 0.260, -0.010, 0.120, 0.080, 0.250, -3.310, 0.140, 0.380 };
		static const double y[] = { 0, -4.870, -4.870, -1.760, -3.510, -5.200, -1.140, 1.630, 9.980, -0.040, -2.240 };
		static const double z[] = { 0, 0.570, 0.570, 0.180, 2.130, 2.650, 3.850, -0.310, 6.310, 0.790, 0.760 };
		if (i <= 0 || i >= x.Size())
			return (0, 0, 0);
		return (x[i], y[i], z[i]);
	}

	clearscope static Vector3 GunRot(int i)
	{
