			3.77, 2.44, 0.66, 0.28, -0.13, 2.00,
			3.55, 2.28, 0.61, 0.28, -0.13, 1.86,
			2.76, 1.82, 0.46, 0.23, -0.13, 1.51,
			1.78, 1.21, 0.28, 0.17, -0.12, 1.02,
			0.59, 0.50, 0.08, 0.07, -0.09, 0.50,
			-0.45, -0.15, -0.08, -0.04, -0.06, 0.01,
			-1.14, -0.60, -0.17, -0.12, -0.03, -0.34,
			-1.41, -0.77, -0.21, -0.15, -0.02, -0.48,
			-1.43, -0.74, -0.21, -0.16, -0.02, -0.42,
			-1.37, -0.63, -0.19, -0.15, -0.03, -0.27,
			-0.84, -0.36, -0.12, -0.09, -0.03, -0.12,
			0.00, -1.33, 0.00, 0.00, 0.16, 0.08,
			0.00, 0.33, 0.00, 0.00, 0.13, 0.67,
			0.00, 0.10, 0.00, 0.00, 0.28, 0.26,
