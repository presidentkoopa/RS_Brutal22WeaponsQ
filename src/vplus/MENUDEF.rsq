// RS VR hands / reload / ballistics (zscript/rsq, zscript/rsr). v9.
// Nothing here changes the engine's two-hand steadying.
//
// NO StaticText help in here, deliberately and by owner's instruction (asked twice). An
// options menu is a list of options. How the reload works is documented in the repo:
// LOAD_ORDER.md and docs/RELOAD_ON_QUEST.md in presidentkoopa/RS_Quest.
AddOptionMenu "OptionsMenu"
{
	Submenu "RS VR Hands, Reload, Ballistics", "RSQ_Options"
}

AddOptionMenu "EDW_Settings"
{
	StaticText " "
	Submenu "RS VR Hands, Reload, Ballistics", "RSQ_Options"
}

OptionValue "RSR_ReloadMode"
{
	1, "VR"
	0, "Stock"
}

OptionValue "RSQ_Ballistics"
{
	0, "Stock"
	1, "Enhanced"
}

OptionValue "RSR_Pouch"
{
	0, "Anywhere, 20 cm from the gun"
	1, "Low, 40 cm below the eyes"
}

OptionMenu "RSQ_Options"
{
	Title "RS VR HANDS, RELOAD, BALLISTICS"
	Option "VR hands", "rsq_hands", "OnOff"
	Option "Reloading", "rsr_reload", "RSR_ReloadMode"
	Slider "Reload assist", "rsr_assist", 0.5, 3.0, 0.1, 1
	Option "Where a magazine comes from", "rsr_pouch", "RSR_Pouch"
	Option "Ballistics", "rsq_ballistics", "RSQ_Ballistics"
	StaticText " "
	Submenu "Reload: tuning and debug", "RSR_Debug"
}

OptionMenu "RSR_Debug"
{
	Title "RELOAD: TUNING AND DEBUG"
	Slider "Reload assist", "rsr_assist", 0.5, 3.0, 0.1, 1
	Option "Show the capture zones", "rsr_assist_debug", "OnOff"
	Option "Print each reload step", "rsr_debug", "OnOff"
}
