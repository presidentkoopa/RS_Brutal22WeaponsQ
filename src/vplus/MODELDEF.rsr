// RS real VR reload (zscript/rsr/vreload.zs, team/reload/tools/gen_rsr.py): V+/VR_Rifle.
// The gun's own model and frames; pieces shown or hidden by a clear skin (HUD models
// are alpha-tested at gl_mask_threshold, so a clear surface is not drawn).

// the gun without its magazine (ready frame)
Model VR_Rifle
{
	Path "Models/Weapons/hud/guns"
	Model 0 "m16.md3"
	SurfaceSkin 0 0 "WPN-M16.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-M16.png"
	SurfaceSkin 0 3 "rsr_clear.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQVM A 0 0
}

// the gun's own frames with the bolt back (2.0 / 5.7 / 7.7 cm)
Model VR_Rifle
{
	Path "Models/Weapons/hud/guns"
	Model 0 "m16.md3"
	SurfaceSkin 0 0 "WPN-M16.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-M16.png"
	SurfaceSkin 0 3 "WPN-M16.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQVM B 0 35
	FrameIndex RQVM C 0 36
	FrameIndex RQVM D 0 37
}

