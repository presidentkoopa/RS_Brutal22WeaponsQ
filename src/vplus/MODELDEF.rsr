// the dropped magazine (world)
Model RSR_DroppedMag
{
	Path "Models/Weapons/hud/guns"
	Model 0 "m16.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "rsr_clear.png"
	SurfaceSkin 0 3 "WPN-M16.png"
	Scale 0.4682 -0.4682 0.4682
	Offset -14.5131 0.0000 0.0
	ZOffset 2.9310
	USEACTORPITCH
	USEACTORROLL
	FrameIndex RQVW A 0 0
}


// RS real VR reload: Ermac's off hand holding a magazine (ammo_hand frame 3), without his
// magazine: the gun's own magazine is drawn in it on layer 2201 (RSR, MODELDEF above)
Model RSQ_Hands
{
	Path "models/rsq"
	Model 0 "ammo_hand.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQHN I 0 3
}
