// The Revolver's (Moonlight's) ammo pickup, RevolverRounds (actors/Weapons/BrutalRevolver.dec): six rounds
// in a ring, tools/moonammo/make_pickup.py (the pack's 12 ga shell cut down to the Moonlight round's length,
// nosed, recoloured from the Moonlight's texture). Scale: the ring's outer diameter = BD22's 4-shell pickup
// SHELA0 (16 px x Scale 0.9 = 14.4 map units). Spins like the voxel pack's ammo (MODELDEF.rsqvox).
Model RevolverRounds
{
	Path "models/rsq/moonammo"
	Model 0 "moon_rounds.md3"
	SurfaceSkin 0 0 "moon_brass.png"
	SurfaceSkin 0 1 "moon_case.png"
	SurfaceSkin 0 2 "moon_primer.png"
	SurfaceSkin 0 3 "moon_nose.png"
	Scale 3.5348 3.5348 3.5348
	AngleOffset 90
	Rotating
	Rotation-Speed 0.450045
	FrameIndex RVRD A 0 0
}

// The Moonlight's own world pickup (BrutalRevolver Spawn: RVMP A), rev.md3 frame 0 lying on its side.
// Gun surfaces 0-3 of frame 0 run x 15.73-42.48 (26.75 mesh units, measured); BD22's revolver pickup
// REVPA0 is 34 px wide: 26.75 x 1.27 x actor Scale 0.9 = 30.6 map units = 34 px x 0.9. Rounds (4-9) and
// the speedloader (10) are collapsed in frame 0 and drawn clear, as in MODELDEF.rsqmoon.
Model BrutalRevolver
{
	Path "models/bd/Moonlight"
	Model 0 "rev.md3"
	SurfaceSkin 0 0 "WPN-REV.png"
	SurfaceSkin 0 1 "WPN-REV.png"
	SurfaceSkin 0 2 "WPN-REV.png"
	SurfaceSkin 0 3 "WPN-REV.png"
	SurfaceSkin 0 4 "rsr_clear.png"
	SurfaceSkin 0 5 "rsr_clear.png"
	SurfaceSkin 0 6 "rsr_clear.png"
	SurfaceSkin 0 7 "rsr_clear.png"
	SurfaceSkin 0 8 "rsr_clear.png"
	SurfaceSkin 0 9 "rsr_clear.png"
	SurfaceSkin 0 10 "rsr_clear.png"
	Scale 1.27 1.27 1.27
	Offset -29.1 0.0 0.0
	ZOffset 2.5
	RollOffset 90
	FrameIndex RVMP A 0 0
}
