// 1.30 GENERATED by kitbash/gen_m203.py -- do not edit by hand
// The M203 under the BD22 rifle: cm in the weapon controller's frame (F forward, L left, U up);
// hooks are ModifyBobLayer3D translations for the rifle's own MODELDEF placement, per cm forward.
class RSM_Geo abstract
{
	const AXIS_L = 0.520;			// the bore
	const AXIS_U = -5.000;
	const FRAME_FRONT = 28.680;		// the receiver's front face
	const TUBE_REAR = 28.440;		// the tube's rear face, closed
	const TUBE_FRONT = 49.200;		// ...and its muzzle, closed
	const TRAVEL = 11.000;			// cm the tube opens
	const ROUND_LEN = 8.550;
	const ROUND_SEAT = 0.400;		// cm the seated round's rear sits in front of the tube's rear

	clearscope static Vector3 FwdHook() { return (0.0000, 0.0000, -1.0000); }
	clearscope static Vector3 RoundInHand() { return (-1.930, 4.560, -4.500); }	// the round's middle, off hand frame
	clearscope static Vector3 RoundAxisInHand() { return (0, 0, 1); }			// its nose (up the grip)
}

