# ---- Git LFS
#
# Only the big binaries go to LFS. base/brutal22test6.pk3 is 152 MB and GitHub hard-blocks any
# single file over 100 MB, so it cannot be stored any other way.
#
# models/ and sprites/ stay in ORDINARY git on purpose: routing them here too would spend the
# whole free LFS quota (1 GB) on content git already stores well.

*.pk3           filter=lfs diff=lfs merge=lfs -text
base/**/*.md3   filter=lfs diff=lfs merge=lfs -text
base/**/*.png   filter=lfs diff=lfs merge=lfs -text
base/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
base/**/*.ogg   filter=lfs diff=lfs merge=lfs -text
base/**/*.wav   filter=lfs diff=lfs merge=lfs -text
base/**/*.lmp   filter=lfs diff=lfs merge=lfs -text
base/**/*.wad   filter=lfs diff=lfs merge=lfs -text
base/**/*.iqm   filter=lfs diff=lfs merge=lfs -text

# Text NEVER goes to LFS, anywhere. An LFS pointer renders as a pointer blob in the GitHub web
# UI, which makes a README or a DECORATE file unreadable in the browser.
*.md            !filter !diff !merge text
*.txt           !filter !diff !merge text
*.zs            !filter !diff !merge text
*.dec           !filter !diff !merge text
*.py            !filter !diff !merge text
*.json          !filter !diff !merge text
*.def           !filter !diff !merge text

# ---- never mangle line endings in a binary
*.md3   -text
*.png   -text
*.jpg   -text
*.iqm   -text
*.ogg   -text
*.wav   -text
*.wad   -text
*.lmp   -text
*.pk3   -text
